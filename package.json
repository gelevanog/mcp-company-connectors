{
  "name": "switchboard",
  "version": "0.1.0",
  "private": true,
  "description": "Switchboard: secure MCP servers and a gateway that connect AI assistants to a company's systems",
  "license": "MIT",
  "author": "Ivan Savchenko",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json --noEmit false && pnpm --filter @switchboard/admin typecheck",
    "lint": "eslint . && pnpm --filter @switchboard/admin lint",
    "test": "vitest run",
    "switchboard": "node packages/cli/dist/main.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
