# Switchboard configuration. Copy to .env (never committed) and change what you need.
# Every variable is optional; the defaults run the local demo.

# ---- Database ---------------------------------------------------------------------------------------------
# Owner connection (schema, demo data, servers' own reads and writes).
DATABASE_URL=postgresql://switchboard:switchboard@127.0.0.1:55480/switchboard
# Read-only login for the analytics server (column grants without personal data). Derived from DATABASE_URL
# with the role below when unset.
# ANALYTICS_DATABASE_URL=postgresql://switchboard_analytics:switchboard_analytics@127.0.0.1:55480/switchboard
ANALYTICS_DB_ROLE=switchboard_analytics
ANALYTICS_DB_PASSWORD=switchboard_analytics
ANALYTICS_MAX_ROWS=200
ANALYTICS_STATEMENT_TIMEOUT_MS=5000
# docker compose only
POSTGRES_PASSWORD=switchboard
GATEWAY_PORT=8080
ADMIN_PORT=3000

# ---- Gateway ----------------------------------------------------------------------------------------------
# The URL clients use. Issuer of every token; the MCP resource is <this>/mcp, the admin API <this>/admin/api.
SWITCHBOARD_PUBLIC_URL=http://localhost:8080
SWITCHBOARD_BIND_HOST=127.0.0.1
PORT=8080
# Policy file: tenants, upstream servers, roles, confirmation rules, rate limits, untrusted-content handling.
SWITCHBOARD_POLICY_FILE=config/switchboard.yaml
SWITCHBOARD_TENANT=kestrel
# Override an upstream server's URL from the policy file (one per server: CRM, HELPDESK, ANALYTICS, KB, WORKSPACE).
# SWITCHBOARD_UPSTREAM_CRM_URL=http://127.0.0.1:7101/mcp
# Demo sign-in page (pick a demo user, no password). Set to false when a real identity provider is wired in.
SWITCHBOARD_DEMO_LOGIN=true
SWITCHBOARD_ACCESS_TOKEN_TTL=900
# Accept any https redirect URI at dynamic client registration (needed for claude.ai and ChatGPT connectors).
SWITCHBOARD_ALLOW_HTTPS_REDIRECTS=true
# Client ID Metadata Documents (client_id is an https URL). SWITCHBOARD_CIMD_ALLOW_INSECURE=true is for tests only.
SWITCHBOARD_CIMD=true
SWITCHBOARD_ADMIN_REDIRECT_URIS=http://localhost:3000/auth/callback
# Browser origins allowed to call /mcp (the admin console, the MCP Inspector).
SWITCHBOARD_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:6274
SWITCHBOARD_LIST_PAGE_SIZE=20
# Lets the evaluation list every tool to every user (calls are still authorized). Keep false in production.
SWITCHBOARD_EVAL_MODE=false
# How the playground reaches the gateway's own /mcp endpoint (defaults to SWITCHBOARD_PUBLIC_URL/mcp).
# SWITCHBOARD_INTERNAL_URL=http://127.0.0.1:8080/mcp
SWITCHBOARD_RESULTS_DIR=results

# ---- MCP servers ------------------------------------------------------------------------------------------
# A server's own URL as the gateway addresses it: the audience its downstream tokens must carry.
# SWITCHBOARD_SERVER_URL=http://127.0.0.1:7101/mcp
# Where servers fetch the gateway's signing keys (defaults to SWITCHBOARD_PUBLIC_URL/oauth/jwks.json).
# SWITCHBOARD_GATEWAY_JWKS_URL=http://127.0.0.1:8080/oauth/jwks.json
# Over stdio a server acts as this one local user with every scope it serves.
SWITCHBOARD_ACTOR=adam
# The gateway over stdio acts as the user in this token (switchboard token --user sam).
# SWITCHBOARD_TOKEN=
KB_DIR=data/kb
# The demo's "today" (relative dates in the data and the tasks). Empty = the real date.
SWITCHBOARD_TODAY=2026-10-01
# silent = no structured logs on stderr
SWITCHBOARD_LOG=

# ---- Models (playground and evaluation) -------------------------------------------------------------------
# Without a key the playground uses the offline demo model. Never commit the key.
OPENROUTER_API_KEY=
SWITCHBOARD_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
SWITCHBOARD_LLM_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free
SWITCHBOARD_LLM_REASONING_EFFORT=low
# Models offered in the playground (each must end in :free while the guard is on).
SWITCHBOARD_PLAYGROUND_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free
# Free-only guard: refuse OpenRouter model ids without :free and answers served by a paid model.
SWITCHBOARD_REQUIRE_FREE_MODELS=true
SWITCHBOARD_LLM_LEDGER=results/calls.jsonl
SWITCHBOARD_LLM_CACHE_DIR=.cache/llm
SWITCHBOARD_LLM_MAX_CALLS=500
SWITCHBOARD_LLM_MIN_INTERVAL_MS=3000

# ---- Tests and evaluation ---------------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql://switchboard:switchboard@127.0.0.1:55480/switchboard_test
# REQUIRE_TEST_DB=1 makes database tests fail instead of skipping when the database is unreachable (CI).
REQUIRE_TEST_DB=
# EVAL_DATABASE_URL=postgresql://switchboard:switchboard@127.0.0.1:55480/switchboard

# ---- Admin console (Next.js) ------------------------------------------------------------------------------
GATEWAY_INTERNAL_URL=http://127.0.0.1:8080
GATEWAY_PUBLIC_URL=http://localhost:8080
ADMIN_PUBLIC_URL=http://localhost:3000
